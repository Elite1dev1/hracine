# Application
NODE_ENV=development
PORT=7000

# MongoDB (required)
# Example: mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
MONGO_URI=
# Optional comma-separated DNS resolvers for networks that block Atlas SRV lookups
MONGODB_DNS_SERVERS=

# Authentication (required; use two different long, random values)
TOKEN_SECRET=
JWT_SECRET_FOR_VERIFY=

# Store/admin URLs used in payment callbacks and email links
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin

# Email (required for verification, password reset, and order emails)
# For a named provider such as Gmail, set SERVICE=gmail.
# For custom SMTP, leave SERVICE blank and set HOST.
SERVICE=
HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (required for image uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Paystack (required for online payments)
# Start with test keys: sk_test_... and pk_test_...
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
