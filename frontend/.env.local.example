# Local backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:7000

# Public canonical storefront URL (SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth browser client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Tag Manager container ID (optional; app has a built-in default)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (optional; app has a built-in existing ID)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Meta Pixel ID (optional; app has a built-in existing Pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=
